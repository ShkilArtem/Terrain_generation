root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h,c}]
indent_style = space
indent_size = 4

[*.{cmake,txt,md,yml,yaml,json,py,ps1}]
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{sln,vcxproj,filters}]
end_of_line = crlf

[*.cmd]
end_of_line = crlf

[Makefile]
indent_style = tab
